{
  "name": "be-aero-desktop",
  "productName": "BE-Aero Desktop",
  "version": "1.3.0",
  "description": "BE-Aero Desktop: a desktop platform - widget sidebar, app dock, Spotlight-style search, web widgets, plugin SDK and local app API.",
  "main": "src/main/main.js",
  "author": {
    "name": "BE-Aero",
    "email": "aero@example.local"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win",
    "pack": "node scripts/make-icon.js && electron-builder --win --dir",
    "dist:linux": "node scripts/make-icon.js && electron-builder --linux"
  },
  "build": {
    "appId": "com.beaero.desktop",
    "productName": "BE-Aero Desktop",
    "files": [
      "src/**/*",
      "sdk/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BE-Aero Desktop"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Aero Widgets",
      "extraResources": [
        {
          "from": "linux/gnome-extension",
          "to": "gnome-extension"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "BE-AI-Research",
        "repo": "be-aero-desktop"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/BE-AI-Research/be-aero-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/BE-AI-Research/be-aero-desktop.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "electron-updater": "^6.8.11"
  }
}
